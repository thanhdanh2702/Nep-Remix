{
  "name": "tiem-may-nep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.mjs",
    "start": "node server.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:core": "tsx scripts/check-core.ts && tsx scripts/check-game.ts",
    "test:c2": "node --import tsx --test src/core/c2-*.test.ts src/game/c2-*.test.ts src/game/asset-registry.test.ts tests/c2-regression.test.ts",
    "test:c2:playtest": "playwright test tests/browser/c2-playtest.spec.ts",
    "test:c2:layout": "C2_MOVEMENT_REVISION=HEAD C2_CHECK_PATH_CLEARANCE=1 node --import tsx --test src/core/c2-layout.test.ts",
    "test:c2:geometry": "playwright test tests/browser/c2-geometry.spec.ts",
    "test:c2:acceptance": "playwright test tests/browser/c2-geometry.spec.ts tests/browser/c2-playtest.spec.ts tests/browser/chapter1.spec.ts tests/browser/sprint01-integration.spec.ts",
    "test:c2:repro": "playwright test --config=playwright.repro.config.ts",
    "test:docs": "node scripts/check-docs.mjs",
    "test:browser": "playwright test",
    "test:assets": "node scripts/check-built-assets.mjs",
    "audit:assets": "python scripts/audit-assets.py",
    "setup": "node scripts/setup.mjs",
    "smoke:ai": "tsx scripts/smoke-gemini.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
