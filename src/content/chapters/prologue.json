  "dialogues": [
    {
      "id": "d-c0-cat",
      "speaker": "Mèo Nếp",
      "nodes": [
        {
          "id": "node-1",
          "text": "Mèo Nếp cọ đầu vào mắt cá chân An, kêu 'Ngoao' ngắn rồi hướng ánh mắt lên cầu thang gỗ."
        }
      ]
    },
    {
      "id": "d-c0-stairs",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Từng bậc gỗ lim mòn nhẵn thời gian dẫn lên gác xép, nơi bà dặn gửi gắm linh hồn nếp áo."
        }
      ]
    },
    {
      "id": "d-c0-mirror",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "An đứng trước gương vuốt phẳng tà áo dài trắng: 'Con sẽ không để tiệm may của bà bị mai một'."
        }
      ]
    },
    {
      "id": "d-c0-wall-key",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Chiếc móc treo trên vách chỉ còn sợi chỉ đỏ sờn, chìa khóa không còn ở đây."
        }
      ]
    },
    {
      "id": "d-c0-hoop",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Khung thêu tròn để dở cạnh chồng báo cũ thập niên 1980, lưu giữ nếp kim mũi chỉ thân thương."
        }
      ]
    },
    {
      "id": "d-c0-ong-le-whisper",
      "speaker": "Bóng mờ Ông Lệ",
      "nodes": [
        {
          "id": "node-1",
          "text": "Mở làm gì... chuyện cũ đã chôn... lệ xưa đã định..."
        }
      ]
    },
    {
      "id": "d-c0-ba-dan-do",
      "speaker": "Bà Ngoại",
      "nodes": [
        {
          "id": "node-1",
          "text": "Chiếc rương này giữ năm nếp áo của năm thế hệ phụ nữ nhà ta. Mỗi chiếc áo là một vết thương đã lành, một lề thói cũ đã bị bẻ gãy.",
          "clueId": "clue-ba-dan-do"
        }
      ]
    }
  ],
