  "dialogues": [
    {
      "id": "d-c3-gramophone",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Mai: Chiếc máy hát ở góc tiệm là một khoảng nghỉ. Tôi còn đang chỉnh đường ráp tay áo từ cổ về nách."
        }
      ]
    },
    {
      "id": "d-c3-street-exit",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Biên nhận cho thấy có người trả tiền để viết lại nhận xét. Tôi sẽ tới phòng hồ sơ để đối chiếu giấy tờ."
        }
      ],
      "when": {
        "all": [
          {
            "kind": "itemOwned",
            "itemId": "bien_nhan_tien_thay_boi"
          },
          {
            "kind": "dialogueCompleted",
            "dialogueId": "d-c3-mua-chuoc"
          }
        ]
      }
    },
    {
      "id": "d-c3-incense-smoke",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Trên bàn có ghi chú khóa và một tráp hồ sơ. Tôi cần đọc giấy tờ để biết điều gì đã bị thay đổi."
        }
      ]
    },
    {
      "id": "d-c3-bagua",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Ghi chú của chủ tráp: “Càn trước, Tốn sau”. Hai nhãn này là mã khóa hư cấu, không phải lời giải bằng phương vị hay bói toán.",
          "clueId": "clue-bagua-hint"
        }
      ],
      "when": {
        "all": [
          {
            "kind": "itemOwned",
            "itemId": "bien_nhan_tien_thay_boi"
          },
          {
            "kind": "dialogueCompleted",
            "dialogueId": "d-c3-mua-chuoc"
          },
          {
            "kind": "dialogueCompleted",
            "dialogueId": "d-c3-street-exit"
          }
        ]
      }
    },
    {
      "id": "d-c3-mua-chuoc",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Chuyện gia đình hư cấu — Biên nhận: Bà Lớn đưa Thầy Ba Càn 2.000 đồng để viết lại nhận xét hồ sơ Mai–Vinh, buộc Mai chấp nhận sự sắp đặt.",
          "clueId": "clue-mua-chuoc-thay-boi"
        }
      ],
      "when": {
        "all": [
          {
            "kind": "itemOwned",
            "itemId": "bien_nhan_tien_thay_boi"
          }
        ]
      }
    },
    {
      "id": "d-c3-so-tu-vi",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Chuyện gia đình hư cấu — Sổ gốc, hồ sơ Mai–Vinh: phần ghi nhận ban đầu không có dòng yêu cầu Mai làm lẽ hoặc giao quyền quyết định căn tiệm. Đây là nội dung để đối chiếu với bản sửa.",
          "clueId": "clue-so-tu-vi-goc"
        }
      ],
      "when": {
        "all": [
          {
            "kind": "itemOwned",
            "itemId": "bien_nhan_tien_thay_boi"
          },
          {
            "kind": "dialogueCompleted",
            "dialogueId": "d-c3-mua-chuoc"
          },
          {
            "kind": "dialogueCompleted",
            "dialogueId": "d-c3-street-exit"
          },
          {
            "kind": "dialogueCompleted",
            "dialogueId": "d-c3-bagua"
          },
          {
            "kind": "puzzleSolved",
            "puzzleId": "p-c3-bagua-lock"
          },
          {
            "kind": "itemOwned",
            "itemId": "so_tu_vi_nguyen_ban_1962"
          },
          {
            "kind": "itemOwned",
            "itemId": "thu_tay_thoa_thuan_boi_toan"
          }
        ]
      }
    },
    {
      "id": "d-c3-thoa-thuan",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Chuyện gia đình hư cấu — Thư thỏa thuận cùng hồ sơ Mai–Vinh: Thầy Ba Càn nhận của Bà Lớn 2.000 đồng để thêm lời phán ép Mai làm lẽ và giao quyền quyết định căn tiệm.",
          "clueId": "clue-thoa-thuan-boi-toan"
        }
