  "dialogues": [
    {
      "id": "d-c2-ca-nghi",
      "speaker": "Ông Cả Nghị",
      "nodes": [
        {
          "id": "node-1",
          "text": "Cả Nghị: Ngày mai cô phải nhận làm vợ kế để trừ món nợ 500 đồng! Loan: Tôi chưa đồng ý. Tôi sẽ tìm giấy tờ và tự nói rõ chuyện này. (Tình huống hư cấu tại phố Hàng Đào, năm 1935.)"
        }
      ]
    },
    {
      "id": "d-c2-mat-ma",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Bản vẽ đã liền lại. Góc giấy ghi: “Hòm sắt tiệm vải Hàng Đào — chìa giấu sau đồng hồ quả lắc.” Đó là gợi ý vị trí chìa, không phải mã số.",
          "clueId": "clue-ban-ve-lemur-mat-ma"
        }
      ]
    },
    {
      "id": "d-c2-silk-shelves",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Những súc lụa Hà Đông, the, sa cao cấp xếp tầng trên kệ, nhưng sự dối trá nằm trong chiếc két sắt góc phòng."
        }
      ]
    },
    {
      "id": "d-c2-bien-lai",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Biên lai trả nợ gốc năm 1935 xác nhận 500 đồng đã được thanh toán từ sáu tháng trước. Tôi sẽ đưa chứng cứ này ra. (Giấy tờ hư cấu trong câu chuyện.)",
          "clueId": "clue-bien-lai-goc-1935"
        }
      ]
    },
    {
      "id": "d-c2-giao-keo",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Giao kèo cho thấy Cả Nghị giấu biên lai để ép tôi làm vợ kế, đổi lấy việc thầu vải. Tôi không chấp nhận giao kèo này. (Giấy tờ hư cấu trong câu chuyện.)",
          "clueId": "clue-giao-keo-ep-hon"
        }
      ]
    },
    {
      "id": "d-c2-ending",
      "speaker": "Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Khoản nợ đã trả. Còn bản vẽ, tôi sẽ tự ký tên.",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "An: Tôi sẽ đứng bên cạnh để mọi người nghe rõ lựa chọn của chị."
        }
      ]
    }
  ],
