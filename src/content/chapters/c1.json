  "dialogues": [
    {
      "id": "d-c1-porridge",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Bát cháo hoa đã đóng váng từ sáng. Nuốt nghẹn đắng họng làm sao trôi khi tự do bị tước đoạt.",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Cụ đẩy bát cháo sang một bên. Phải tìm đường ra khỏi gian buồng này."
        }
      ]
    },
    {
      "id": "d-c1-locked-door",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Cửa chính bị khóa ngoài bằng xích sắt kiên cố, Trưởng tộc quyết tâm giam cầm mình trong này.",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Cửa trước đã bị khóa chặt. Chỉ còn lối cửa chớp phía sau buồng."
        }
      ]
    },
    {
      "id": "d-c1-tiet-hanh",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Tấm biển 'Tiết Hạnh Khả Phong' sơn còn thơm mùi nhựa thông, nhưng chữ vàng này tẩm bằng nước mắt người góa phụ.",
          "clueId": "clue-tiet-hanh-kha-phong",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Cụ lặng nhìn tấm biển thêm một lúc rồi quay đi."
        }
      ]
    },
    {
      "id": "d-c1-incense",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Khói trầm hương nồng nặc nghi ngút che giấu sự dối trá dưới chân các bài vị tổ tiên.",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Cụ lùi lại, mắt dõi theo làn khói bay về phía bàn thờ tổ."
        }
      ]
    },
    {
      "id": "d-c1-thu-chong",
      "speaker": "Chồng Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Nếu nghe tin anh xấu số, xin em đừng giam mình thủ tiết theo lệ làng hà khắc. Hãy tự do sống cuộc đời của em.",
          "clueId": "clue-thu-chong-cu-cam",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Em hãy giữ lấy lá thư này, và đừng để ai bắt em sống một đời không phải của mình."
        }
      ]
    },
    {
      "id": "d-c1-van-tu",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Tờ văn tự này chứng minh Trưởng tộc đem gán ruộng dệt của vợ chồng tôi để trả nợ cờ bạc!",
          "clueId": "clue-van-tu-ban-dat",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Có tờ văn tự này, sự thật đã nằm trong tay tôi. Giờ phải mang nó ra trước thềm đình."
        }
      ]
    },
    {
      "id": "d-c1-giai-phong",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Từ hôm nay, nếp áo dệt của làng Vạn Phúc là để tôn vinh sự cần cù và tự do của người phụ nữ, không phải tấm vải liệm thanh xuân!",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Nói xong, cụ ngẩng cao đầu, bước chân nhẹ hẳn đi."
        }
      ]
    },
    {
      "id": "d-c1-gate-exit",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Cổng đình làng mở rộng đón gió xuân. Tự do này, cụ sẽ trao truyền lại cho con cháu muôn đời sau.",
          "nextNodeId": "node-2"
        },
        {
          "id": "node-2",
          "text": "Cụ khoác tà áo ngũ thân, bước qua cổng đình. Câu chuyện của Cụ Cầm khép lại ở đây, nhưng nếp áo vẫn còn đi tiếp."
        }
      ]
    }
  ],
