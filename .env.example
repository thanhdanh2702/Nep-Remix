# Copy to .env for local dev. On Cloud Run set these as environment variables / secrets instead.
# Gemini API key from https://aistudio.google.com/apikey (server-side only, never exposed to the browser)
GEMINI_API_KEY=
PORT=3000
NODE_ENV=development
# Lookbook: trần toàn cục mỗi ngày (UTC), tính bằng số bộ ảnh 4 góc. Hết trần trả về quota_exhausted. Mặc định 10.
LOOKBOOK_DAILY_LIMIT=10
# Lookbook: khóa ký token ảnh hero (HMAC). Để trống = sinh ngẫu nhiên mỗi lần khởi động (token cũ mất hiệu lực khi restart).
LOOKBOOK_HERO_SECRET=
